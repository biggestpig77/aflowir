# Copy this file to .env and enter your mail provider's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
# Optional. Defaults to SMTP_USER.
SMTP_FROM=your-account@example.com
SMTP_TO=your-account@example.com
HOST=127.0.0.1
PORT=3000
